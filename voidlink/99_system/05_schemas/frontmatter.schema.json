{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoidLink Frontmatter",
  "description": "Base frontmatter of every vault note. Mirrors what raxovile/voidCore writes (dot_config/nvim/lua/notes/frontmatter.lua, docs/VAULT_STRUCTURE.md, ADR-005, docs/WORK_TAXONOMY.md). vault-agent additionally checks that id equals the file name stem.",
  "type": "object",
  "required": ["title", "id", "created", "tags", "category"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "id": {
      "description": "The file name stem (ADR-005), e.g. 20260921_1030_note_title, 20260921 or acme_client_index. An all-digit stem written unquoted reads as an integer.",
      "type": ["string", "integer"],
      "minimum": 0,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "created": { "$ref": "#/$defs/timestamp" },
    "updated": { "$ref": "#/$defs/timestamp" },
    "archived": { "$ref": "#/$defs/timestamp" },
    "date": { "$ref": "#/$defs/date" },
    "lang": { "type": "string", "enum": ["en", "de"] },
    "category": {
      "type": "string",
      "enum": [
        "project",
        "area",
        "resource",
        "knowledge",
        "index",
        "task",
        "meeting",
        "person",
        "client",
        "daily",
        "weekly"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "in-progress",
        "in_progress",
        "waiting",
        "review",
        "draft",
        "done",
        "completed",
        "cancelled",
        "archived",
        "deleted"
      ]
    },
    "type": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+([-_/][a-z0-9]+)*$" }
    },
    "client": { "$ref": "#/$defs/optionalSlug" },
    "project": { "$ref": "#/$defs/optionalSlug" },
    "due": { "$ref": "#/$defs/optionalDate" },
    "wait_until": { "$ref": "#/$defs/optionalDate" },
    "priority": { "type": "string" },
    "task_uuid": { "type": "string" },
    "participants": { "type": "array", "items": { "type": "string" } },
    "email": { "type": "string" },
    "role": { "type": "string" },
    "related": { "type": "array", "items": { "type": "string" } },
    "concepts": { "type": "array", "items": { "type": "string" } },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "source": { "type": "string", "enum": ["manual", "inbox", "ai"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  },
  "allOf": [
    {
      "description": "Project, task and client notes are queried by status.",
      "if": {
        "required": ["category"],
        "properties": { "category": { "enum": ["project", "task", "client"] } }
      },
      "then": { "required": ["status"] }
    },
    {
      "description": "Training notes (voidlink#22): terms and value ranges follow voidCore's docs/voidsystem/DOMAIN_MODEL.md, the field reference is 99_system/05_schemas/training_schema.md.",
      "if": {
        "required": ["type"],
        "properties": {
          "type": { "enum": ["exercise", "training_routine", "workout", "training_evaluation"] }
        }
      },
      "then": {
        "properties": {
          "category": { "const": "area" },
          "tags": { "contains": { "const": "training" } }
        }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "exercise" } } },
      "then": { "$ref": "#/$defs/exercise" }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "training_routine" } } },
      "then": { "$ref": "#/$defs/trainingRoutine" }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "workout" } } },
      "then": { "$ref": "#/$defs/workout" }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "training_evaluation" } } },
      "then": { "$ref": "#/$defs/trainingEvaluation" }
    }
  ],
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "optionalDate": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },
    "optionalSlug": {
      "description": "Slug grammar of docs/WORK_TAXONOMY.md in voidCore, or empty.",
      "type": "string",
      "pattern": "^([a-z0-9]+(_[a-z0-9]+)*)?$"
    },
    "ref": {
      "description": "Stable VoidSystem-internal handle (*_ref): minted once, never changed on rename or move.",
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "optionalRef": { "type": "string", "pattern": "^([a-z0-9]+(_[a-z0-9]+)*)?$" },
    "refList": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "seconds": { "description": "A duration in whole seconds.", "type": "integer", "minimum": 0 },
    "rpe": {
      "description": "Rate of perceived exertion, 1 to 10 in 0.5 steps.",
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "multipleOf": 0.5
    },
    "weight": {
      "description": "External load in the note's weight_unit; 0 for bodyweight only.",
      "type": "number",
      "minimum": 0
    },
    "weightUnit": { "type": "string", "enum": ["kg", "lb"] },
    "order": {
      "description": "Stable 1-based position of the exercise in the routine or workout.",
      "type": "integer",
      "minimum": 1
    },
    "supersetGroup": {
      "description": "Entries sharing a value form one superset, executed in order (voidApi#36).",
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "trainingGoal": {
      "type": "string",
      "enum": ["strength", "hypertrophy", "skill", "endurance", "conditioning", "mobility"]
    },
    "exercise": {
      "required": [
        "exercise_ref",
        "exercise_type",
        "movement_pattern",
        "muscle_groups",
        "equipment"
      ],
      "properties": {
        "exercise_ref": { "$ref": "#/$defs/ref" },
        "exercise_type": {
          "type": "string",
          "enum": ["strength", "skill", "conditioning", "mobility"]
        },
        "movement_pattern": {
          "type": "string",
          "enum": ["push", "pull", "squat", "hinge", "carry", "core", "locomotion"]
        },
        "muscle_groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "secondary_muscle_groups": { "$ref": "#/$defs/refList" },
        "equipment": {
          "description": "Empty for a bodyweight exercise.",
          "$ref": "#/$defs/refList"
        },
        "progression_level": {
          "description": "1 beginner, 2 intermediate, 3 advanced, 4 elite.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "prerequisites": { "$ref": "#/$defs/refList" },
        "regressions": { "$ref": "#/$defs/refList" },
        "progressions": { "$ref": "#/$defs/refList" },
        "status": { "enum": ["active", "archived"] }
      }
    },
    "plannedExercise": {
      "description": "One exercise of a routine with its targets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise_ref", "order", "sets"],
      "anyOf": [{ "required": ["reps"] }, { "required": ["duration"] }],
      "properties": {
        "exercise_ref": { "$ref": "#/$defs/ref" },
        "order": { "$ref": "#/$defs/order" },
        "superset_group": { "$ref": "#/$defs/supersetGroup" },
        "sets": { "type": "integer", "minimum": 1 },
        "reps": {
          "description": "Target reps, or the lower bound when reps_max is set.",
          "type": "integer",
          "minimum": 1
        },
        "reps_max": { "type": "integer", "minimum": 1 },
        "duration": { "$ref": "#/$defs/seconds" },
        "weight": { "$ref": "#/$defs/weight" },
        "rest": { "$ref": "#/$defs/seconds" },
        "rpe": { "$ref": "#/$defs/rpe" },
        "tempo": {
          "description": "Eccentric, bottom, concentric, top in seconds; X is explosive.",
          "type": "string",
          "pattern": "^[0-9X]{4}$"
        },
        "notes": { "type": "string" }
      }
    },
    "trainingRoutine": {
      "required": ["routine_ref", "goal", "weight_unit", "exercises"],
      "properties": {
        "routine_ref": { "$ref": "#/$defs/ref" },
        "goal": { "$ref": "#/$defs/trainingGoal" },
        "split": {
          "type": "string",
          "enum": ["full_body", "upper", "lower", "push", "pull", "legs", "skill"]
        },
        "weight_unit": { "$ref": "#/$defs/weightUnit" },
        "status": { "enum": ["draft", "active", "archived"] },
        "exercises": { "type": "array", "items": { "$ref": "#/$defs/plannedExercise" } }
      },
      "if": { "not": { "required": ["status"], "properties": { "status": { "const": "draft" } } } },
      "then": { "properties": { "exercises": { "minItems": 1 } } }
    },
    "performedSet": {
      "description": "One set as it was executed.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["reps"] },
        { "required": ["duration"] },
        { "required": ["status"], "properties": { "status": { "const": "skipped" } } }
      ],
      "properties": {
        "reps": { "type": "integer", "minimum": 0 },
        "duration": { "$ref": "#/$defs/seconds" },
        "weight": { "$ref": "#/$defs/weight" },
        "rest": { "$ref": "#/$defs/seconds" },
        "rpe": { "$ref": "#/$defs/rpe" },
        "rir": { "type": "integer", "minimum": 0, "maximum": 10 },
        "status": { "description": "Absent means done.", "enum": ["done", "skipped"] },
        "notes": { "type": "string" }
      }
    },
    "performedExercise": {
      "description": "One exercise of a workout with the sets actually performed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise_ref", "order", "sets"],
      "properties": {
        "exercise_ref": { "$ref": "#/$defs/ref" },
        "order": { "$ref": "#/$defs/order" },
        "superset_group": { "$ref": "#/$defs/supersetGroup" },
        "sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/performedSet" } },
        "notes": { "type": "string" }
      }
    },
    "workout": {
      "required": ["date", "status", "weight_unit", "entries"],
      "properties": {
        "status": { "enum": ["planned", "in_progress", "completed", "cancelled"] },
        "routine_ref": {
          "description": "The routine this workout executed; empty for an ad-hoc workout.",
          "$ref": "#/$defs/optionalRef"
        },
        "workout_ref": {
          "description": "The workout's id in voidApi once synced; the vault does not mint it.",
          "type": "string",
          "pattern": "^([A-Za-z0-9]+([_-][A-Za-z0-9]+)*)?$"
        },
        "started_at": {
          "description": "Local start, ISO 8601 with an explicit offset.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "duration": { "$ref": "#/$defs/seconds" },
        "rpe": { "$ref": "#/$defs/rpe" },
        "weight_unit": { "$ref": "#/$defs/weightUnit" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/performedExercise" } }
      },
      "if": { "required": ["status"], "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "entries": { "minItems": 1 } } }
    },
    "trainingEvaluation": {
      "required": ["period_start", "period_end"],
      "properties": {
        "period_start": { "$ref": "#/$defs/date" },
        "period_end": { "$ref": "#/$defs/date" },
        "routine_ref": { "$ref": "#/$defs/optionalRef" },
        "focus_exercises": { "$ref": "#/$defs/refList" }
      }
    }
  },
  "additionalProperties": true
}
